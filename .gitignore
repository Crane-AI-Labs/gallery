.DS_Store
release/
*.apk
google-services.json

# ── Secrets (never commit) ────────────────────────────────────────────────
*.secrets.env
*.secret.env
.env.local
.env.*.local

# TLS / auth artefacts — keep the config + public cert, drop the key
*.key
*.key.*
*.htpasswd
*.pem.bak

# SSH / GPG
id_rsa
id_ed25519
*.ppk

# ── Local scratch (keep the repo tidy) ────────────────────────────────────
.claude/
Android/Untitled
APK-README.md
FORMAT_TEST_PLAN.md
INFERENCE_PERFORMANCE_LOG.md

# ── Internal working docs (keep locally, not for upstream) ────────────────
# Bug reports, perf/benchmark investigations, device metrics, handoffs and
# internal strategy notes. Useful to us; noise to anyone who finds the repo.
Bug_Reporting_Guide.md
Health_Demo_Project_Summary.md
DEVELOPMENT_REPORT.md
DEVICE_BENCHMARK_REPORT.md
ONDEVICE_METRICS_REPORT.md
GENERATION_SPEEDUP_INVESTIGATION.md
SPEC_DECODE_BENCHMARK.md
PERF_ROADMAP.md
LUGANDA_TRANSLATION_BUG.md
WEATHERNEXT_HANDOFF.md
VISION_OPTIMIZATIONS.md
PIPELINE_CHANGES_CHECKLIST.md
benchmark-artifacts-*/
# Bug reports / exported office docs are internal by default here
*.pdf
*.docx
*.doc

# ── On-device model weights (never committed; shipped/downloaded separately)
*.onnx
*.gguf
*.task
*.part[a-z][a-z]

# ── Build outputs ─────────────────────────────────────────────────────────
Android/src/app/build/
Android/src/build/
Android/src/.gradle/
Android/src/**/local.properties

# ── Python venvs / caches from backend dev ────────────────────────────────
uganda-backend/.venv/
uganda-backend/**/__pycache__/
uganda-backend/**/*.pyc
