[Unit]
Description=Ease Health ETL (tier-1 -> tier-2 with NER)
After=network.target postgresql.service

[Service]
Type=oneshot
User=easehealth-etl
Group=easehealth-etl
WorkingDirectory=/opt/easehealth-etl
EnvironmentFile=/opt/easehealth-etl/.env
ExecStart=/opt/easehealth-etl/.venv/bin/python /opt/easehealth-etl/promote.py
TimeoutStartSec=10min
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/easehealth-etl
StandardOutput=journal
StandardError=journal
