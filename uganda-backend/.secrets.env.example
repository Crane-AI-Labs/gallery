# Copy to .secrets.env and fill in. NEVER commit .secrets.env.
# Generate new values with: openssl rand -base64 32 | tr -d '=+/' | head -c 32

# ── Postgres roles ────────────────────────────────────────────────────────
DB_API_PASSWORD=
DB_ETL_PASSWORD=
DB_RO_PASSWORD=
DB_METABASE_PASSWORD=

# ── Server-side HMAC keys ─────────────────────────────────────────────────
# Rotating DEVICE_TOKEN_SECRET invalidates every enrolled device — prefer
# per-device revocation via scripts/revoke-device.sh.
DEVICE_TOKEN_SECRET=
# Do NOT rotate PSEUDONYM_SECRET once tier_2 has rows — pseudonyms will change
# and analytics dashboards will break.
PSEUDONYM_SECRET=

# ── Metabase ──────────────────────────────────────────────────────────────
METABASE_ENCRYPTION_KEY=
METABASE_PROXY_USER=easehealth
METABASE_PROXY_PASSWORD=
