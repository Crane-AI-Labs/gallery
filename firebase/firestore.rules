rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /assessments/{docId} {
      allow read, write: if request.auth != null;
    }
    match /paused_consultations/{docId} {
      allow read, write: if request.auth != null;
    }
    match /device_diagnostics/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
